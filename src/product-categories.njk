---
layout: layouts/wordpress.njk
pagination:
  data: wordpress.productCategories
  size: 1
  alias: wp
permalink: "{{ wp.outputPath }}"
eleventyComputed:
  title: "{{ wp.titleText }}"
  description: "{{ wp.descriptionText or ('Les produits : ' + wp.titleText) }}"
  canonicalUrl: "{{ wp.link }}"
---
