<?php
declare(strict_types=1);
define('CD2027_PRIVATE_VIEW', {% if site.privateView %}true{% else %}false{% endif %});

$siteRoot = realpath(__DIR__);
$configPath = dirname(__DIR__, 2) . '/cd2027-auth-config.php';

function cd2027_fail(int $status, string $message): never
{
    http_response_code($status);
    header('Content-Type: text/plain; charset=utf-8');
    header('Cache-Control: no-store, private');
    header('X-Content-Type-Options: nosniff');
    exit($message);
}

function cd2027_return_path(mixed $value): string
{
    if (
        !is_string($value)
        || $value === ''
        || $value[0] !== '/'
        || str_starts_with($value, '//')
        || str_contains($value, '\\')
        || preg_match('/[\x00-\x20\x7f]/', $value)
    ) {
        return '/';
    }

    $parts = parse_url($value);
    return $parts === false || isset($parts['scheme']) || isset($parts['host']) ? '/' : $value;
}

function cd2027_redirect_to_staging(string $stagingOrigin, string $path): never
{
    if ($stagingOrigin !== 'https://cd2027.christinedeloupy.fr') {
        cd2027_fail(503, 'CD2027 access is not configured.');
    }

    header('X-Redirect-By: CD2027', true);
    header('Location: ' . $stagingOrigin . cd2027_return_path($path), true, 302);
    exit;
}

