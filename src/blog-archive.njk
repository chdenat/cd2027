---
layout: layouts/base.njk
pagination:
  data: wordpress.blogArchives
  size: 1
  alias: archive
permalink: "{{ archive.outputPath }}"
eleventyComputed:
  title: "{{ 'Mon Blog' if archive.pageNumber == 1 else 'Mon Blog · page ' + archive.pageNumber }}"
  description: "{{ site.description }}"
  canonicalUrl: "{{ archive.link }}"
---
