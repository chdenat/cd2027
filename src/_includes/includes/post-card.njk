<wa-card class="content-card" appearance="outlined"{% if post.image %} with-media{% endif %} with-footer>
  {% if post.image %}<img class="content-card__image" slot="media" src="{{ post.image }}" alt="{{ post.imageAlt }}" loading="lazy" />{% endif %}
  <div class="content-card__body">
    <p class="eyebrow">par Christine · {{ post.date | frenchDate }}</p>
    <h2><wa-button id="article-title-{{ post.id }}" href="{{ post.path }}" appearance="plain" class="card-title">{{ post.titleText }}</wa-button></h2>
    <wa-tooltip for="article-title-{{ post.id }}" trigger="hover focus">{{ post.titleText }}</wa-tooltip>
    {% set excerpt = post.archiveExcerptText or post.excerptText %}
    {% if excerpt %}<p>{{ excerpt | summary }}</p>{% endif %}
  </div>
  <div slot="footer" class="wa-cluster wa-justify-content-end"><wa-button class="article-read-more" href="{{ post.path }}" appearance="outlined" variant="brand" size="s"><wa-icon library="pro" slot="start" name="book-open" variant="solid" aria-hidden="true"></wa-icon>Lire<span class="wa-visually-hidden"> : {{ post.titleText }}</span></wa-button></div>
</wa-card>
