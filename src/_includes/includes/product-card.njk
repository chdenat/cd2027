<wa-card class="product-card" appearance="outlined"{% if product.image %} with-media{% endif %} with-footer>
  {% if product.image %}<img class="product-card__image" slot="media" src="{{ product.image }}" alt="{{ product.imageAlt }}" loading="lazy" />{% endif %}
  <div class="product-card__body">
    <h2><wa-button href="{{ product.path }}" appearance="plain" class="card-title">{{ product.titleText }}</wa-button></h2>
    {% if product.price %}<p class="product-price">{{ product.price | price }}</p>{% endif %}
  </div>
  {% if product.purchasable and product.inStock %}
    <wa-button slot="footer" class="product-card__action" variant="brand" appearance="outlined" data-add-to-cart="{{ product.id }}">Ajouter au panier</wa-button>
  {% else %}
    <wa-button slot="footer" class="product-card__action" href="{{ product.path }}" variant="brand" appearance="outlined">Découvrir</wa-button>
  {% endif %}
</wa-card>
