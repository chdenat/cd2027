{% include "includes/page-hero.njk" %}
{% if wp.slug == 'panier' %}
  <section class="commerce-page content-width" data-commerce-page="cart">
    <div id="cart-view" class="commerce-layout" aria-live="polite"><wa-card class="commerce-panel" appearance="outlined"><div class="commerce-loading"><wa-spinner></wa-spinner><span>Chargement du panier…</span></div></wa-card></div>
  </section>
  {% if wp.recommendationProducts.length %}
    <section class="cart-recommendations content-width" data-cart-recommendations hidden>
      <h2>Nouveau dans la boutique</h2>
      <div class="product-grid">{% for product in wp.recommendationProducts %}{% include "includes/product-card.njk" %}{% endfor %}</div>
    </section>
  {% endif %}
{% elif wp.slug == 'commande' %}
  <section class="commerce-page content-width" data-commerce-page="checkout">
    <div id="checkout-view" class="commerce-layout" aria-live="polite"><wa-card class="commerce-panel" appearance="outlined"><div class="commerce-loading"><wa-spinner></wa-spinner><span>Chargement de la commande…</span></div></wa-card></div>
  </section>
{% elif wp.slug == 'boutique' or wp.slug == 'std-boutique' %}
  <article class="wordpress-page cd-content">
    <div class="entry-content">{{ wp.contentHtml | safe }}</div>
  </article>
{% else %}
  <article class="wordpress-page cd-content{% if wp.slug == 'contact' %} contact-page{% endif %}{% if wp.slug == 'lecture-akashique' %} wordpress-page--lecture-akashique{% endif %}">
    <div class="entry-content">{{ wp.contentHtml | safe }}</div>
  </article>
{% endif %}
