<nav class="post-category-nav wa-cluster" aria-label="Parcourir les catégories du journal">
  <wa-button href="/mon-blog/" appearance="{{ 'filled' if currentCategory is not defined else 'plain' }}" variant="{{ 'brand' if currentCategory is not defined else 'neutral' }}" size="s"{% if currentCategory is not defined %} aria-current="page"{% endif %}>Tous les articles</wa-button>
  {% for category in wordpress.postCategories %}
    <wa-button href="{{ category.path }}" appearance="{{ 'filled' if currentCategory == category.id else 'plain' }}" variant="{{ 'brand' if currentCategory == category.id else 'neutral' }}" size="s"{% if currentCategory == category.id %} aria-current="page"{% endif %}>{{ category.titleText }}</wa-button>
  {% endfor %}
</nav>
