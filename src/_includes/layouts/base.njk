<html lang="fr" class="wa-theme-cd2027 wa-palette-cd2027 cd2027-button-purple wa-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
      (() => {
        try {
          const backgroundPalettes = {
            rose: 'wa-palette-cd2027',
            green: 'wa-palette-cd2027-green',
            blue: 'wa-palette-cd2027-blue',
            orange: 'wa-palette-cd2027-orange'
          }
          const buttonPalettes = {
            purple: 'cd2027-button-purple',
            rose: 'cd2027-button-rose',
            green: 'cd2027-button-green',
            blue: 'cd2027-button-blue',
            orange: 'cd2027-button-orange'
          }
          const oldBackground = localStorage.getItem('cd2027-color-palette')
          const selectedBackground = localStorage.getItem('cd2027-background-palette') || oldBackground
          const selectedButton = localStorage.getItem('cd2027-button-palette') || localStorage.getItem('cd2027-heading-palette')
          const background = Object.hasOwn(backgroundPalettes, selectedBackground) ? selectedBackground : 'rose'
          const button = Object.hasOwn(buttonPalettes, selectedButton) ? selectedButton : 'purple'
          const scheme = localStorage.getItem('cd2027-color-scheme')
          const dark = scheme === 'dark' || (scheme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
          document.documentElement.classList.remove(...Object.values(backgroundPalettes), ...Object.values(buttonPalettes))
          document.documentElement.classList.add(backgroundPalettes[background], buttonPalettes[button])
          document.documentElement.classList.toggle('wa-dark', dark)
          document.documentElement.classList.toggle('wa-light', !dark)
        } catch {}
      })()
    </script>
    <meta name="description" content="{{ description or site.description }}" />
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    {% if image %}<meta property="og:image" content="{{ image }}" />{% endif %}
    {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}" />{% endif %}
    <link rel="icon" href="{{ site.favicon }}" type="image/png" />
    <link rel="stylesheet" href="/assets/webawesome/styles/webawesome.css" />
    <link rel="stylesheet" href="/assets/theme.css" />
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="stylesheet" href="/assets/wordpress-content.css" />
    <title>{{ title or site.name }} · {{ site.name }}</title>
  </head>
  <body>
    {% set isShopContext = wp and (wp.kind == 'product' or wp.kind == 'product-category' or wp.slug == 'boutique' or wp.slug == 'std-boutique' or wp.slug == 'panier' or wp.slug == 'commande') %}
    {% set headerNavigation = wordpress.shopNavigation if isShopContext else wordpress.navigation %}
    <wa-page>
      <header slot="header" class="site-header section-gutter">
        <div class="site-identity">
          <wa-button class="brand-mark" href="/" appearance="plain" aria-label="{{ site.name }}, accueil">
            <img class="theme-logo" src="{{ site.logo }}" alt="" width="90" height="90" />
          </wa-button>
          <nav class="site-social wa-desktop-only" aria-label="Réseaux sociaux">
            {% for item in site.socialLinks %}<wa-button href="{{ item.href }}" target="_blank" rel="noopener noreferrer" appearance="plain" size="s" aria-label="{{ item.label }}"><wa-icon library="pro" name="{{ item.icon }}" family="brands" aria-hidden="true"></wa-icon></wa-button>{% endfor %}
          </nav>
        </div>

        <nav class="header-nav" aria-label="{{ 'Navigation de la boutique' if isShopContext else 'Navigation principale' }}">
          {% for item in headerNavigation %}
            {% if item.href == '/panier/' and isShopContext %}
              <wa-button class="cart-link" href="{{ item.href }}" appearance="plain" size="s" aria-label="Voir le panier">
                <wa-icon library="pro" name="basket-shopping" variant="solid" label="Voir le panier" aria-hidden="true"></wa-icon>{{ item.label }} <wa-badge data-cart-badge hidden variant="brand" pill><span data-cart-count aria-live="polite">0</span></wa-badge>
              </wa-button>
            {% elif item.href != '/panier/' %}
              {% if item.items and item.items.length > 0 %}
                <wa-dropdown class="nav-dropdown" placement="bottom-start">
                  <wa-button slot="trigger" appearance="plain" size="s" with-caret>{{ item.label }}</wa-button>
                  {% for child in item.items %}<wa-dropdown-item value="{{ child.href }}" data-href="{{ child.href }}">{{ child.label }}</wa-dropdown-item>{% endfor %}
                </wa-dropdown>
              {% else %}
                <wa-button href="{{ item.href }}" appearance="plain" size="s">{{ item.label }}</wa-button>
              {% endif %}
            {% endif %}
          {% endfor %}
        </nav>

        <div class="header-tools">
          {% if not isShopContext %}
            <wa-button class="header-cart-link" href="/panier/" appearance="plain" size="s" aria-label="Voir le panier">
              <wa-icon library="pro" name="basket-shopping" variant="solid" label="Voir le panier" aria-hidden="true"></wa-icon>
              <wa-badge slot="end" data-cart-badge hidden variant="brand" pill><span data-cart-count aria-live="polite">0</span></wa-badge>
            </wa-button>
          {% endif %}
          <wa-button id="cd2027-palette-selector-trigger" data-palette-selector-trigger appearance="plain" size="s" aria-label="Choisir les couleurs du site" aria-haspopup="true">
            <wa-icon library="pro" name="palette" variant="solid" aria-hidden="true"></wa-icon>
          </wa-button>
          <wa-popover class="theme-selector theme-selector--palette" for="cd2027-palette-selector-trigger" placement="bottom-end" distance="8">
            <div class="theme-selector__palette-rows wa-stack wa-gap-s">
              <div class="theme-selector__palette-row wa-cluster wa-align-items-center wa-gap-s" role="group" aria-label="Palette des fonds">
                <wa-icon library="pro" name="star" variant="solid" aria-hidden="true"></wa-icon>
                <div class="theme-selector__palette-choices wa-cluster wa-align-items-center wa-gap-xs">
                  <wa-button data-background-palette="rose" data-popover="close" appearance="plain" size="s" aria-label="Fond rose" aria-pressed="true"></wa-button>
                  <wa-button data-background-palette="green" data-popover="close" appearance="plain" size="s" aria-label="Fond vert" aria-pressed="false"></wa-button>
                  <wa-button data-background-palette="blue" data-popover="close" appearance="plain" size="s" aria-label="Fond bleu" aria-pressed="false"></wa-button>
                  <wa-button data-background-palette="orange" data-popover="close" appearance="plain" size="s" aria-label="Fond orange" aria-pressed="false"></wa-button>
                </div>
              </div>
              <div class="theme-selector__palette-row wa-cluster wa-align-items-center wa-gap-s" role="group" aria-label="Palette des textes, boutons, du logo et des titres">
                <wa-icon library="pro" name="pen-fancy" variant="solid" aria-hidden="true"></wa-icon>
                <div class="theme-selector__palette-choices wa-cluster wa-align-items-center wa-gap-xs">
                  <wa-button data-button-palette="purple" data-popover="close" appearance="plain" size="s" aria-label="Textes et boutons violets" aria-pressed="true"></wa-button>
                  <wa-button data-button-palette="rose" data-popover="close" appearance="plain" size="s" aria-label="Textes et boutons roses" aria-pressed="false"></wa-button>
                  <wa-button data-button-palette="green" data-popover="close" appearance="plain" size="s" aria-label="Textes et boutons verts" aria-pressed="false"></wa-button>
                  <wa-button data-button-palette="blue" data-popover="close" appearance="plain" size="s" aria-label="Textes et boutons bleus" aria-pressed="false"></wa-button>
                  <wa-button data-button-palette="orange" data-popover="close" appearance="plain" size="s" aria-label="Textes et boutons orange" aria-pressed="false"></wa-button>
                </div>
              </div>
            </div>
          </wa-popover>
          <wa-button id="cd2027-theme-selector-trigger" data-theme-selector-trigger appearance="plain" size="s" aria-label="Choisir le mode d’affichage" aria-haspopup="true">
            <wa-icon library="pro" data-theme-selector-icon name="circle-half-stroke" variant="solid" aria-hidden="true"></wa-icon>
          </wa-button>
          <wa-popover class="theme-selector theme-selector--mode" for="cd2027-theme-selector-trigger" placement="bottom-end" distance="8">
            <div class="theme-selector__choices" role="group" aria-label="Choisir le mode d’affichage">
              <wa-button data-theme-choice="system" data-popover="close" appearance="plain" size="s" aria-label="Automatique, selon l’appareil" aria-pressed="false">
                <wa-icon library="pro" name="desktop" variant="solid" aria-hidden="true"></wa-icon>
              </wa-button>
              <wa-button data-theme-choice="light" data-popover="close" appearance="plain" size="s" aria-label="Thème clair" aria-pressed="false">
                <wa-icon library="pro" name="sun-bright" variant="solid" aria-hidden="true"></wa-icon>
              </wa-button>
              <wa-button data-theme-choice="dark" data-popover="close" appearance="plain" size="s" aria-label="Thème sombre" aria-pressed="false">
                <wa-icon library="pro" name="moon" variant="solid" aria-hidden="true"></wa-icon>
              </wa-button>
            </div>
          </wa-popover>
          <wa-button data-toggle-nav appearance="plain" class="wa-mobile-only nav-toggle" aria-label="Ouvrir le menu">
            <wa-icon library="pro" name="bars" variant="solid" aria-hidden="true"></wa-icon>
          </wa-button>
        </div>
      </header>

      <nav slot="navigation" class="mobile-navigation" aria-label="Navigation mobile">
        <div class="wa-stack wa-gap-xs">
          {% if not isShopContext %}<wa-button href="/" appearance="plain" data-drawer="close">Accueil</wa-button>{% endif %}
          {% for item in headerNavigation %}
            {% if item.href == '/panier/' and isShopContext %}
              <wa-button class="cart-link" href="{{ item.href }}" appearance="plain" data-drawer="close" aria-label="Voir le panier">
                <wa-icon library="pro" name="basket-shopping" variant="solid" label="Voir le panier" aria-hidden="true"></wa-icon>{{ item.label }} <wa-badge data-cart-badge hidden variant="brand" pill><span data-cart-count aria-live="polite">0</span></wa-badge>
              </wa-button>
            {% elif item.href != '/panier/' %}
              {% if item.items and item.items.length > 0 %}
                <wa-dropdown class="mobile-nav-dropdown" placement="bottom-start">
                  <wa-button slot="trigger" appearance="plain" with-caret>{{ item.label }}</wa-button>
                  {% for child in item.items %}<wa-dropdown-item value="{{ child.href }}" data-href="{{ child.href }}">{{ child.label }}</wa-dropdown-item>{% endfor %}
                </wa-dropdown>
              {% else %}
                <wa-button href="{{ item.href }}" appearance="plain" data-drawer="close">{{ item.label }}</wa-button>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
        <wa-divider></wa-divider>
        <nav class="site-social site-social--mobile" aria-label="Réseaux sociaux">
          {% for item in site.socialLinks %}<wa-button href="{{ item.href }}" target="_blank" rel="noopener noreferrer" appearance="plain" size="s"><wa-icon library="pro" slot="start" name="{{ item.icon }}" family="brands" aria-hidden="true"></wa-icon>{{ item.label }}</wa-button>{% endfor %}
        </nav>
      </nav>

      <main id="contenu">
        {{ content | safe }}
      </main>

      {% include "includes/site-footer.njk" %}
    </wa-page>
    {% if site.stagingAuth %}
      <wa-button class="staging-auth-action" href="/__cd2027/logout/" appearance="filled" variant="brand">
        <wa-icon slot="start" library="pro" name="right-from-bracket" variant="solid" aria-hidden="true"></wa-icon>Déconnexion WordPress
      </wa-button>
    {% endif %}
    <script type="module" src="/assets/main.js"></script>
  </body>
</html>
