{
  "name": "cd2026",
  "version": "1.0.0",
  "description": "Starter Eleventy piloté par Bun avec Web Awesome et Font Awesome",
  "main": "index.js",
  "scripts": {
    "dev": "bun run build:site && bunx @11ty/eleventy --serve",
    "build": "bun run build:site && bun run build:assets",
    "build:site": "bunx @11ty/eleventy",
    "build:assets": "bun build src/assets/main.js --outdir _site/assets --minify",
    "start": "bun run dev",
    "check": "bun run build"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@awesome.me/webawesome": "^3.11.0",
    "@fortawesome/fontawesome-free": "^7.3.1"
  }
}
