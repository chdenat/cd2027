WEBHOOK_SECRET=change-me-with-a-long-random-secret
WEBHOOK_PORT=8787
WEBHOOK_HOST=127.0.0.1
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_MAX_TIMESTAMP_AGE_SECONDS=300
WEBHOOK_STORE_DIR=.data/webhooks/pending
WEBHOOK_PROCESSED_DIR=.data/webhooks/processed

# Configure only on the internet-reachable webhook host.
GITHUB_DISPATCH_TOKEN=replace-with-a-server-side-token
GITHUB_REPOSITORY=owner/repository
GITHUB_DISPATCH_EVENT_TYPE=cd2026_staging_deploy
